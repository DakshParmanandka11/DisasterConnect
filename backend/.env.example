# Copy to backend/.env (which is git-ignored) and fill in. NEVER commit real values.

# ── TinyFish (evidence lookup for moderators) ──
# Server-side only. Do NOT prefix with VITE_ and never put this in frontend code.
# Create a key in the TinyFish dashboard; docs: https://docs.tinyfish.ai/authentication
TINYFISH_API_KEY=

# Optional overrides (defaults shown)
# TINYFISH_SEARCH_URL=https://api.search.tinyfish.ai
# TINYFISH_FETCH_URL=https://api.fetch.tinyfish.ai
# TINYFISH_SEARCH_TIMEOUT_MS=10000
# TINYFISH_FETCH_TIMEOUT_MS=20000
# TINYFISH_LOCAL_RPM=20

# ── Core ──
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
